{
  "ConnectionStrings": {
    "OrderDb": "Host=localhost;Port=5432;Database=OrderManagement;Username=postgres;Password=postgres"
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoUsers": false
  },
  "Orders": {
    "DuplicateWindowSeconds": 60
  },
  "Jwt": {
    "Issuer": "OrderManagement",
    "Audience": "OrderManagement",
    "SigningKey": "",
    "LifetimeMinutes": 480
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] [{CorrelationId}] [{UserName}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/order-management-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
